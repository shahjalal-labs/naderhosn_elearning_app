    {
      "name": "2. Verify Signup OTP & Activate Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/verify-signup-otp",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "verify-signup-otp"
          ]
        },
        "description": "Step 2: Submits the 4-digit OTP. The backend validates it, auto-generates a unique username (e.g. s48291), moves the record from pending_users to users with isManualSignup: true, and returns the credentials and accessToken."
      },
      "response": [
        {
          "name": "200 OK - User Verified & Created",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer.student@apple.com\",\n  \"otp\": \"4821\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-signup-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-signup-otp"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"statusCode\": 200,\n  \"success\": true,\n  \"message\": \"User verified and registered successfully.\",\n  \"data\": {\n    \"userName\": \"s48291\",\n    \"email\": \"reviewer.student@apple.com\",\n    \"fullName\": \"Apple Reviewer Student\",\n    \"role\": \"Student\",\n    \"accessToken\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\"\n  }\n}"
        },
        {
          "name": "401 Unauthorized - Invalid OTP",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer.student@apple.com\",\n  \"otp\": \"0000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-signup-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-signup-otp"
              ]
            }
          },
          "status": "Unauthorized",
          "code": 401,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"statusCode\": 401,\n  \"success\": false,\n  \"message\": \"Invalid OTP.\"\n}"
        },
        {
          "name": "410 Gone - OTP Expired",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer.student@apple.com\",\n  \"otp\": \"4821\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-signup-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-signup-otp"
              ]
            }
          },
          "status": "Gone",
          "code": 410,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"statusCode\": 410,\n  \"success\": false,\n  \"message\": \"OTP has expired. Please sign up again.\"\n}"
        }
      ]
