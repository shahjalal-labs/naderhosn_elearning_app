{
  "info": {
    "_postman_id": "8bfa2e1c-5d63-4819-a1b7-99432e19efaa",
    "name": "Manual User Signup (Apple Submission)",
    "description": "Collection for manual Student and Teacher sign up flow built for Apple App Store Review compliance. Includes 2-step OTP registration, login with auto-generated username or email, and admin cleanup endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.darelchimalapp.com/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "reviewer.student@apple.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Signup - Student (JSON)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Apple Reviewer Student\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"reviewPassword123\",\n  \"role\": \"Student\",\n  \"gender\": \"Male\",\n  \"phone\": \"+12025550143\",\n  \"DOB\": \"2004-05-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/signup",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "signup"
          ]
        },
        "description": "Step 1: Initiates signup for a student. Generates a 4-digit OTP, holds info in temporary pending_users table, and emails OTP."
      },
      "response": [
        {
          "name": "200 OK - OTP Sent",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Apple Reviewer Student\",\n  \"email\": \"reviewer.student@apple.com\",\n  \"password\": \"reviewPassword123\",\n  \"role\": \"Student\",\n  \"gender\": \"Male\",\n  \"phone\": \"+12025550143\",\n  \"DOB\": \"2004-05-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"statusCode\": 200,\n  \"success\": true,\n  \"message\": \"OTP sent to your email. Please verify to complete registration.\",\n  \"data\": {\n    \"email\": \"reviewer.student@apple.com\"\n  }\n}"
        },
        {
          "name": "409 Conflict - Email Already Exists",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Apple Reviewer Student\",\n  \"email\": \"existing.user@apple.com\",\n  \"password\": \"reviewPassword123\",\n  \"role\": \"Student\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            }
          },
          "status": "Conflict",
          "code": 409,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ],
          "cookie": [],
          "body": "{\n  \"statusCode\": 409,\n  \"success\": false,\n  \"message\": \"User with this email already exists\"\n}"
        }
