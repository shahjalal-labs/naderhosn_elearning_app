    {
      "name": "5. Admin - Clean Up / Delete All Manual Signups",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "{{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/user/manual-signups",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "manual-signups"
          ]
        },
        "description": "Admin endpoint to wipe all test users registered through the manual signup flow after the Apple review is completed."
      },
      "response": [
