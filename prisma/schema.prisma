datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  loginUserName String     @unique
  fullName      String?
  email         String?
  password      String
  gender        Gender?
  DOB           DateTime?
  phone         String?
  profileImage  String?    @default("https://i.ibb.co.com/nrs3FjM/images.png")
  role          UserRole
  status        UserStatus @default(Active)

  isManualSignup Boolean?   @default(false) // ONLY FOR APPLE SUBMISSION - Tracks manual signups for easy removal

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  fcmToken String?

  // Relations
  StudentGrades          StudentGrades[]
  Teacher                TeacherGrades[]
  assignments            AssignmentStudent[]
  teachersBookCategories teachersBookCategories[]

  @@map("users")
}

// ONLY FOR APPLE SUBMISSION - Temporary pending user registrations before OTP verification
model PendingUser {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  fullName     String?
  email        String     @unique
  password     String
  gender       Gender?
  DOB          DateTime?
  phone        String?
  profileImage String?    @default("https://i.ibb.co.com/nrs3FjM/images.png")
  role         UserRole   @default(Student)
  otpCode      String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@map("pending_users")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

enum UserStatus {
  Active
  Blocked
  Deleted
  Inactive
}

enum Gender {
  Male
  Female
}

enum UserRole {
  Admin
  Student
  Teacher
}

// --------------------------// Noptification -------------------------------------//
model Notification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String?  @db.ObjectId
  senderId   String?  @db.ObjectId
  title      String?
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

// --------------------- SCHOOL ----------------------//

model School {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  location        String?
  teacherCount    Int?
  studentsCount   Int?
  activeStudents  Int?
  activeTeachers  Int?
  schoolLogo      String?
  grades          Grades[]
  schoolDocuments String[]

  // date 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grades {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  grade         String
  schoolId      String          @db.ObjectId
  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  StudentGrades StudentGrades[]
  TeacherGrades TeacherGrades[]
  // gradeSubject  gradeSubject[]
  Assingment    Assignment[]
  Announcments  Announcments[]
  GradeBooks    GradeBooks[]

  @@unique([schoolId, grade])
}

