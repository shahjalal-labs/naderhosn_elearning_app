//---------------------  Student Grades ---------------------//
model StudentGrades {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  studentId String @db.ObjectId
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradeId   String @db.ObjectId
  grade     Grades @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, gradeId])
  @@map("gradeStudents")
}

model TeacherGrades {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String @db.ObjectId
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  gradeId   String @db.ObjectId
  grade     Grades @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, gradeId])
  @@map("GradeTeachers")
}

model GradeBooks {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  bookId  String @db.ObjectId
  book    Books  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  gradeId String @db.ObjectId
  grade   Grades @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, gradeId]) // ensure same book-grade pair only once
  @@map("grade_books")
}

// ------------------Books ----------------------------////

model BookCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  image       String?
  Books       Books[]

  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  teachersBookCategories teachersBookCategories[]
}

model teachersBookCategories {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  teacherId  String       @db.ObjectId
  teacher    User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  categoryId String       @db.ObjectId
  category   BookCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, categoryId])
  @@map("teacherBookCategories")
}

model Books {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  bookName    String?
  description String?
  ISBN        String?
  author      String?
  coverImg    String?
  file        String?
  RTL         Boolean      @default(false)
  // Date 
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  // Relations
  categoryId  String       @db.ObjectId
  category    BookCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  Assignment  Assignment[]
  Resources   Resources[]
  GradeBooks  GradeBooks[]

  @@map("gradeBooks")
}

// ----------------------------Resources ------------------
model Resources {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  Type        ResoucresType?
  file        String?
  bookId      String         @db.ObjectId
  book        Books          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  uplodedBy   String?
  uploderName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gradeResources")
}

enum ResoucresType {
  Audio
  Video
  Pdf
  Image
  Link
}

// ------------------ Assingmnet ---------------//

model Assignment {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  startPage   String
  endPage     String
  instruction String
  attachament String?
  dueDate     DateTime
  gradeId     String              @db.ObjectId
  grade       Grades              @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  bookId      String              @db.ObjectId
  book        Books               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  students    AssignmentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssignmentStudent {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String           @db.ObjectId
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId       String           @db.ObjectId
  studentAnswer      String?
  studentAttachement String?
  assignmentStatus   AssignmentStatus @default(Pending)
  assignmentGrade    AssignmentGrade?
  gradedBy           String?
  FeedBack           String?
  submittedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, assignmentId])
}

enum AssignmentStatus {
  Pending
  Missed
  Graded
  Submitted
}

enum AssignmentGrade {
  A_plus  @map("A+")
  A       @map("A")
  A_minus @map("A-")
  B_plus  @map("B+")
  B       @map("B")
  B_minus @map("B-")
  C_plus  @map("C+")
  C       @map("C")
  C_minus @map("C-")
  D       @map("D")
  F       @map("F")
}

// --------------------------- announcments -----------------// 

model Announcments {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  anouncement String
  postdate    DateTime
  isPublished Boolean?
  publishBy   UserRole
  gradeId     String?  @db.ObjectId
  grade       Grades?  @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gradeAnnouncement")
}
