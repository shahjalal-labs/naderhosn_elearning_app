datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  loginUserName String     @unique
  fullName      String
  email         String     @unique
  password      String
  gender        Gender?
  DOB           DateTime?
  phone         String?
  profileImage  String     @default("https://i.ibb.co.com/nrs3FjM/images.png")
  role          UserRole
  status        UserStatus @default(Active)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  fcmToken String?

  // Relations
  notificationRecipient NotificationRecipient[]
  StudentGrades         StudentGrades[]
  Teacher               TeacherGrades[]
  assignments           AssignmentStudent[]

  @@map("users")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

enum UserStatus {
  Active
  Blocked
  Deleted
}

enum Gender {
  Male
  Female
  Other
}

enum UserRole {
  Admin
  Student
  Teacher
}

// --------------------------// Noptification -------------------------------------//
model Notification {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  message          String
  redirectEndpoint String?
  users            NotificationRecipient[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("notifications")
}

model NotificationRecipient {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  isRead         Boolean       @default(false)
  receivedAt     DateTime      @default(now())
  notification   Notification? @relation(fields: [notificationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  notificationId String        @db.ObjectId
  userId         String        @db.ObjectId
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("notificationRecipient")
}

// --------------------- SCHOOL ----------------------//

model School {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  location         String
  expectedTeachers Int
  expectedStudents Int
  schoolLogo       String
  grades           SchoolGrades[]

  // date 
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  Teacher       TeacherGrades[]
  StudentGrades StudentGrades[]
}

model SchoolGrades {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  grade         Int
  section       SchoolSectionEnum
  schoolId      String            @db.ObjectId
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  StudentGrades StudentGrades[]
  TeacherGrades TeacherGrades[]
  Books         Books[]
  gradeSubject  gradeSubject[]
  Resources     Resources[]
  Assingment    Assignment[]
  Announcments  Announcments[]

  @@unique([schoolId, grade, section])
}

enum SchoolSectionEnum {
  A
  B
  C
}

model gradeSubject {
  id      String       @id @default(auto()) @map("_id") @db.ObjectId
  subject String?
  gradeId String       @db.ObjectId
  grade   SchoolGrades @relation(fields: [gradeId], references: [id])

  @@map("gradeSubjects")
}

//---------------------  Student Grades ---------------------//
model StudentGrades {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId String       @db.ObjectId
  student   User         @relation(fields: [studentId], references: [id])
  gradeId   String       @db.ObjectId
  grade     SchoolGrades @relation(fields: [gradeId], references: [id])
  School    School?      @relation(fields: [schoolId], references: [id])
  schoolId  String?      @db.ObjectId
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("gradeStudents")
}

model TeacherGrades {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  teacherId String       @db.ObjectId
  teacher   User         @relation(fields: [teacherId], references: [id])
  gradeId   String       @db.ObjectId
  grade     SchoolGrades @relation(fields: [gradeId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  School    School?      @relation(fields: [schoolId], references: [id])
  schoolId  String?      @db.ObjectId

  @@unique([teacherId, gradeId, schoolId])
  @@map("GradeTeachers")
}

// ------------------Books ----------------------------////

model Books {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  gradeId  String       @db.ObjectId
  grade    SchoolGrades @relation(fields: [gradeId], references: [id])
  bookName String
  coverImg String
  file     String
  author   String
  Edition  String
  language Booklanguage

  @@map("gradeBooks")
}

// ----------------------------Resources ------------------
model Resources {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  Type        ResoucresType?
  gradeId     String         @db.ObjectId
  grade       SchoolGrades   @relation(fields: [gradeId], references: [id])

  @@map("gradeResources")
}

enum ResoucresType {
  Audio
  Video
  File
}

// ------------------ Assingmnet ---------------//

model Assignment {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  startPage   Int
  endPage     Int
  instruction String
  attachament String?
  dueDate     DateTime
  gradeId     String       @db.ObjectId
  grade       SchoolGrades @relation(fields: [gradeId], references: [id])

  students AssignmentStudent[]
}

model AssignmentStudent {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  user         User       @relation(fields: [userId], references: [id])
  userId       String     @db.ObjectId
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  assignmentId String     @db.ObjectId
  submittedAt  DateTime?
  score        Float?

  @@unique([userId, assignmentId])
}

enum Booklanguage {
  English
  Spanish
  French
}

// --------------------------- announcments -----------------// 

model Announcments {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  anouncement String
  postdate    DateTime
  gradeId     String       @db.ObjectId
  grade       SchoolGrades @relation(fields: [gradeId], references: [id])

  @@map("gradeAnnouncement")
}
