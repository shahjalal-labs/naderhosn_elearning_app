datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  loginUserName String     @unique
  name          String
  email         String     @unique
  uniqueId      String?    @unique
  password      String
  gender        Gender?
  DOB           DateTime?
  phone         String?
  profileImage  String     @default("https://i.ibb.co.com/nrs3FjM/images.png")
  role          UserRole
  status        UserStatus @default(Active)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  fcmToken String?

  // Relations
  sentMessages          Message[]               @relation("SentMessages")
  receivedMessages      Message[]               @relation("ReceivedMessages")
  notificationRecipient NotificationRecipient[]
  roomsAsSender         Room[]                  @relation("user1Relation")
  roomsAsReceiver       Room[]                  @relation("user2Relation")
  StudentGrades         StudentGrades[]
  Teacher               TeacherGrades[]

  @@map("users")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  otpCode   String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

enum UserStatus {
  Active
  Blocked
  Deleted
}

enum Gender {
  Male
  Female
  Other
}

enum UserRole {
  Admin
  Student
  Teacher
}

// --------------------------// Room -------------------------------------//

model Room {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  user1Id   String?   @db.ObjectId
  user2Id   String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user1     User?     @relation("user1Relation", fields: [user1Id], references: [id])
  user2     User?     @relation("user2Relation", fields: [user2Id], references: [id])
  message   Message[]

  @@unique([user1Id, user2Id])
  @@map("rooms")
}

model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  senderId   String   @db.ObjectId
  sender     User?    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String   @db.ObjectId
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
  Room       Room?    @relation(fields: [roomId], references: [id])
  roomId     String?  @db.ObjectId

  @@map("messages")
}

// --------------------------// Noptification -------------------------------------//
model Notification {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  message          String
  redirectEndpoint String?
  users            NotificationRecipient[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@map("notifications")
}

model NotificationRecipient {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  isRead         Boolean       @default(false)
  receivedAt     DateTime      @default(now())
  notification   Notification? @relation(fields: [notificationId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  notificationId String        @db.ObjectId
  userId         String        @db.ObjectId
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("notificationRecipient")
}

// --------------------- SCHOOL ----------------------//

model School {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  location         String
  expectedTeachers Int
  expectedStudents Int
  schoolLogo       String
  grades           SchoolGrades[]

  // date 
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  Teacher   TeacherGrades[]
}

model SchoolGrades {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  grade         Int
  section       SchoolSectionEnum
  subject       subjectEnum
  schoolId      String            @db.ObjectId
  school        School            @relation(fields: [schoolId], references: [id])
  StudentGrades StudentGrades[]
  TeacherGrades TeacherGrades[]
  Books         Books[]
}

enum SchoolSectionEnum {
  A
  B
  C
}

enum subjectEnum {
  Math
  Science
  English
  others
}

//---------------------  Student Grades ---------------------//
model StudentGrades {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  studentId String       @db.ObjectId
  student   User         @relation(fields: [studentId], references: [id])
  gradeId   String       @db.ObjectId
  grade     SchoolGrades @relation(fields: [gradeId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model TeacherGrades {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  user      User         @relation(fields: [userId], references: [id])
  gradeId   String       @db.ObjectId
  grade     SchoolGrades @relation(fields: [gradeId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  School    School?      @relation(fields: [schoolId], references: [id])
  schoolId  String?      @db.ObjectId

  @@map("teachers")
}

model Books {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  gradeId  String       @db.ObjectId
  grade    SchoolGrades @relation(fields: [gradeId], references: [id])
  bookName String
  coverImg String
  file     String
  author   String
  Edition  String
  language Booklanguage
}

enum Booklanguage {
  English
  Spanish
  French
}
